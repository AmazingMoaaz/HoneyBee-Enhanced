{
  "version": "3.0",
  "protocol_version": 3,
  "repository": "https://github.com/H0neyBe/honeybee_potstore",
  "last_updated": "2026-05-02",
  "pots": [
    {
      "id": "cowrie",
      "name": "Cowrie",
      "version": "2.9.0",
      "type": "cowrie",
      "git_url": "https://github.com/H0neyBe/honeybee_potstore",
      "git_branch": "main",
      "subdir": "cowrie",
      "entry_point": "",
      "install_cmd": [],
      "run_cmd": [],
      "language": "python",
      "description": "Medium to high interaction SSH and Telnet honeypot. Auto-configured to forward events to the local HoneyBee node on TCP 9100.",
      "protocols": ["ssh", "telnet"],
      "default_ports": {"ssh": 2222, "telnet": 2223},
      "requirements": {"python": ">=3.9", "os": ["linux", "windows", "macos"]},
      "status": "stable",
      "features": [
        "SSH honeypot",
        "Telnet honeypot",
        "Command logging",
        "File download tracking",
        "Session recording",
        "HoneyBee output plugin (auto-installed)"
      ],
      "honeybee_integration": {
        "event_port": 9100,
        "event_format": "json",
        "output_plugin": "honeybee.py",
        "auto_configure": true
      }
    },
    {
      "id": "honnypotter",
      "name": "HonnyPotter",
      "version": "1.2.0",
      "type": "honnypotter",
      "git_url": "https://github.com/H0neyBe/honeybee_potstore",
      "git_branch": "main",
      "subdir": "HonnyPotter",
      "entry_point": "standalone.php",
      "install_cmd": [],
      "run_cmd": [],
      "language": "php",
      "description": "WordPress login honeypot - captures brute-force attacks and credential stuffing. Forwards events via honeybee-forwarder.php to TCP 9100.",
      "protocols": ["http"],
      "default_ports": {"http": 8080},
      "requirements": {"php": ">=7.4", "php_extensions": ["json", "sockets"], "os": ["linux", "windows", "macos"]},
      "status": "stable",
      "features": [
        "WordPress login emulation",
        "Brute-force / credential stuffing capture",
        "XML-RPC attack detection",
        "Auto-configured HoneyBee forwarder",
        "Standalone PHP built-in webserver"
      ],
      "honeybee_integration": {
        "event_port": 9100,
        "event_format": "json",
        "forwarder": "honeybee-forwarder.php",
        "auto_configure": true
      }
    },
    {
      "id": "webtrap",
      "name": "WebTrap",
      "version": "1.0.0",
      "type": "webtrap",
      "git_url": "https://github.com/H0neyBe/honeybee_potstore",
      "git_branch": "main",
      "subdir": "WebTrap",
      "entry_point": "standalone.py",
      "install_cmd": [],
      "run_cmd": [],
      "language": "python",
      "description": "Vulnerable web application honeypot - fake admin panels, REST/GraphQL APIs, file uploads, misconfigured services. Forwards full request capture to TCP 9100.",
      "protocols": ["http"],
      "default_ports": {"http": 8088},
      "requirements": {"python": ">=3.8", "python_packages": ["Flask>=2.3", "PyYAML>=6.0"], "os": ["linux", "windows", "macos"]},
      "status": "stable",
      "features": [
        "Fake admin panels (WordPress, Joomla, phpMyAdmin, generic /admin)",
        "REST and GraphQL API traps",
        "File upload + webshell detection",
        "Misconfigured-service traps (.env, .git, phpinfo, /actuator)",
        "Heuristic payload tagging (sqli/xss/rce/lfi/ssrf/log4shell/ssti)",
        "Per-IP session tracking",
        "Optional canary credentials"
      ],
      "honeybee_integration": {
        "event_port": 9100,
        "event_format": "json",
        "forwarder": "webtrap/forwarder.py",
        "auto_configure": true
      }
    }
  ],
  "coming_soon": [
    {"id": "dionaea", "name": "Dionaea", "type": "dionaea", "description": "Low-interaction multi-protocol honeypot", "status": "planned"},
    {"id": "kippo",    "name": "Kippo",    "type": "kippo",    "description": "Classic SSH honeypot",                    "status": "planned"},
    {"id": "glastopf", "name": "Glastopf", "type": "glastopf", "description": "Web application honeypot",               "status": "planned"}

  "installation": {"method": "git_clone", "default_branch": "main", "depth": 1},
  "configuration": {
    "supported_config_keys": [
      "ssh_port", "telnet_port", "http_port", "https_port",
      "hostname", "log_path", "data_path",
      "pot_id", "bind_host", "bind_port",
      "tls_cert", "tls_key",
      "canary_username", "canary_password"
    ]
  },
  "node_compatibility": {"min_version": "1.0.0", "protocol": 3}
